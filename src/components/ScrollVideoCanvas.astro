<section id="canvas-hero" class="canvas-scroll-section">
  <!-- Fixed Fullscreen Canvas Scrubber Container -->
  <div class="canvas-sticky-wrapper">
    <canvas id="sequence-canvas"></canvas>

    <!-- Canvas Loading Overlay Screen -->
    <div id="canvas-loader" class="canvas-loader-screen">
      <div class="loader-content">
        <div class="loader-spinner"></div>
        <p class="loader-title">SEO USTAAD USA — MOTION ENGINE</p>
        <div class="progress-bar-bg">
          <div id="loader-progress" class="progress-bar-fill"></div>
        </div>
        <span id="loader-text" class="progress-percentage">0%</span>
      </div>
    </div>

    <!-- Pinned GSAP Text Overlays -->
    <div class="pinned-overlays-container">
      <!-- Overlay Frame 1: Hero -->
      <div class="overlay-card active" id="overlay-1">
        <span class="eyebrow-tag">SEO USTAAD USA — WEB ENGINEERING</span>
        <h1 class="hero-display">We Build Search-Dominant Motion Websites.</h1>
        <p class="lead-text">Apple-grade 60fps scroll canvas physics paired with sub-second Core Web Vitals and AI Answer Engine Optimization (AEO/GEO) for US disruptors.</p>
        <div class="cta-group">
          <a href="#booking-modal" class="button-primary">Book US Discovery Call</a>
          <a href="#services" class="button-secondary-pill">Explore Architecture</a>
        </div>
      </div>

      <!-- Overlay Frame 2: Physics -->
      <div class="overlay-card" id="overlay-2">
        <span class="eyebrow-tag">01 / CANVAS MOTION PHYSICS</span>
        <h2 class="display-lg">Zero Video Stutter. True 60 FPS Hardware Scrub.</h2>
        <p class="body-text">While native HTML5 <code>&lt;video&gt;</code> scrubbing stutters on iOS Safari, our specialized Canvas WebGL engine synchronizes directly with GPU hardware for fluid, zero-lag frame scrubbing.</p>
      </div>

      <!-- Overlay Frame 3: Speed & SEO -->
      <div class="overlay-card" id="overlay-3">
        <span class="eyebrow-tag">02 / CORE WEB VITALS & TECH SEO</span>
        <h2 class="display-lg">100/100 Google Lighthouse Score Guaranteed.</h2>
        <p class="body-text">Rich interactive motion doesn't have to ruin Google rankings. Built on Astro.js static zero-JS architecture for sub-second LCP, zero CLS, and instant indexing by Googlebot.</p>
      </div>

      <!-- Overlay Frame 4: AEO / GEO -->
      <div class="overlay-card" id="overlay-4">
        <span class="eyebrow-tag">03 / AEO & GEO AI SEARCH DOMINANCE</span>
        <h2 class="display-lg">Engineered for ChatGPT, Claude, & Google AI Overviews.</h2>
        <p class="body-text">We structure your digital footprint into machine-readable JSON-LD entities, positioning <strong>SEO Ustaad USA</strong> clients as the primary cited authority across AI answer engines.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .canvas-scroll-section {
    position: relative;
    height: 400vh; /* 4 viewports for scroll trigger scrubbing */
    background-color: #000000;
  }

  .canvas-sticky-wrapper {
    position: sticky;
    top: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #sequence-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  /* Preloader Overlay */
  .canvas-loader-screen {
    position: absolute;
    inset: 0;
    background-color: #050507;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }

  .canvas-loader-screen.loaded {
    opacity: 0;
    visibility: hidden;
  }

  .loader-content {
    text-align: center;
    max-width: 340px;
    width: 100%;
  }

  .loader-spinner {
    width: 36px;
    height: 36px;
    margin: 0 auto 16px;
    border: 2px solid rgba(0, 102, 204, 0.2);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .loader-title {
    font-size: 11px;
    letter-spacing: 0.15em;
    color: var(--color-ink-muted-48);
    margin-bottom: 12px;
  }

  .progress-bar-bg {
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 8px;
  }

  .progress-bar-fill {
    height: 100%;
    width: 0%;
    background: var(--color-primary-on-dark);
    transition: width 0.1s linear;
  }

  .progress-percentage {
    font-size: 12px;
    color: #ffffff;
    font-family: monospace;
  }

  /* Pinned Text Overlay Cards */
  .pinned-overlays-container {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .overlay-card {
    position: absolute;
    max-width: 760px;
    width: 100%;
    text-align: center;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: auto;
    background: rgba(10, 10, 12, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 44px 36px;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .overlay-card.active {
    opacity: 1;
    transform: translateY(0);
  }

  .eyebrow-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-primary-on-dark);
    margin-bottom: 12px;
  }

  .overlay-card h1, .overlay-card h2 {
    color: #ffffff;
    margin-bottom: 16px;
  }

  .overlay-card p {
    color: var(--color-body-muted);
    margin-bottom: 24px;
  }

  .cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
</style>
