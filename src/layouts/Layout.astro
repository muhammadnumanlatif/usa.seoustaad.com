---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SEO Ustaad USA | Super-Fast Websites That Bring You US Customers",
  description = "SEO Ustaad USA builds 1-second loading 3D websites that rank #1 on Google and get recommended by ChatGPT. Ready in 14 days with zero monthly fees."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://usa-seoustaad-com.pages.dev");

// AEO & GEO Structured JSON-LD Data for SEO Ustaad USA (Super Simple Schema)
const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "SEO Ustaad USA",
  "alternateName": ["SEO Ustaad", "SEO Ustaad US Web Development"],
  "image": "https://usa-seoustaad-com.pages.dev/og-image.jpg",
  "@id": "https://usa-seoustaad-com.pages.dev/#organization",
  "url": "https://usa-seoustaad-com.pages.dev",
  "telephone": "+1-800-555-0199",
  "priceRange": "$$$$",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "US",
    "addressRegion": "CA",
    "addressLocality": "San Francisco"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 37.7749,
    "longitude": -122.4194
  },
  "areaServed": [
    { "@type": "Country", "name": "United States" },
    { "@type": "State", "name": "California" },
    { "@type": "State", "name": "New York" },
    { "@type": "State", "name": "Texas" }
  ],
  "knowsAbout": [
    "Fast Web Development USA",
    "ChatGPT Search Recommendation (AEO/GEO)",
    "3D Scroll Animation",
    "Google Search #1 Ranking"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "SEO Ustaad USA Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Super Fast 1-Second Web Development",
          "description": "Custom websites that load in under 1 second and turn visitors into paying US customers."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "ChatGPT & Google Search Dominance (AEO/GEO)",
          "description": "Getting your business recommended first on ChatGPT, Google, and Siri."
        }
      }
    ]
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="keywords" content="SEO Ustaad USA, fast web development USA, cheap high quality web design, get customers from ChatGPT, website ready in 14 days" />
  <meta name="author" content="SEO Ustaad USA" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph / Facebook / LinkedIn -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="SEO Ustaad USA" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Meta Tags -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />

  <!-- Fonts & Preloads -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- AEO & GEO Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(professionalServiceSchema)} />
</head>
<body>
  <slot />
</body>
</html>
