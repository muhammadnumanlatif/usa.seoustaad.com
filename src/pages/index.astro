---
import Layout from '../layouts/Layout.astro';
import HeaderNav from '../components/HeaderNav.astro';
import ScrollVideoCanvas from '../components/ScrollVideoCanvas.astro';
import ServiceTiers from '../components/ServiceTiers.astro';
import AeoFaqSection from '../components/AeoFaqSection.astro';
import ProjectEstimatorModal from '../components/ProjectEstimatorModal.astro';
import locations from '../data/locations.json';
---

<Layout title="SEO Ustaad USA | Super-Fast 1-Second Websites That Get You Customers">
  <HeaderNav />

  <main>
    <ScrollVideoCanvas />
    <ServiceTiers />
    <AeoFaqSection />
  </main>

  <footer class="apple-footer">
    <div class="footer-container">
      <div class="footer-grid">
        <div class="footer-col">
          <h4>SEO Ustaad USA Services</h4>
          <ul>
            <li><a href="#services">Super-Fast 1-Second Web Design</a></li>
            <li><a href="#services">ChatGPT & Google #1 Ranking</a></li>
            <li><a href="#performance">100/100 Speed Score Guarantee</a></li>
            <li><a href="#us-advantage">14-Day Delivery Sprint</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>US Target Markets</h4>
          <ul>
            {locations.map((loc) => (
              <li>
                <a href={`/locations/${loc.slug}`}>
                  Web Development {loc.fullName}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="footer-col">
          <h4>Our Technology Guarantee</h4>
          <ul>
            <li>Astro.js Static Architecture</li>
            <li>GSAP 3 Smooth Scroll Physics</li>
            <li>100% Code Ownership</li>
            <li>Zero Hidden Monthly Fees</li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© 2026 SEO Ustaad USA. All Rights Reserved. Built for High-Ticket US Business Growth.</p>
      </div>
    </div>
  </footer>

  <ProjectEstimatorModal />

  <!-- Initialize GSAP ScrollTrigger Engine -->
  <script>
    import { initScrollEngine } from '../scripts/scroll-engine.js';
    document.addEventListener('DOMContentLoaded', () => {
      initScrollEngine();
    });
  </script>
</Layout>

<style>
  .apple-footer {
    background-color: var(--color-canvas-parchment);
    color: var(--color-ink-muted-80);
    padding: 64px 24px 32px;
    border-top: 1px solid var(--color-hairline);
  }

  .footer-container {
    max-width: 1080px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
    margin-bottom: 48px;
  }

  .footer-col h4 {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 16px;
    letter-spacing: 0.02em;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col a, .footer-col li {
    font-size: 13px;
    color: var(--color-ink-muted-80);
    text-decoration: none;
    line-height: 1.5;
  }

  .footer-col a:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    padding-top: 24px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    text-align: center;
  }

  .footer-bottom p {
    font-size: 12px;
    color: var(--color-ink-muted-48);
  }
</style>
