---
// AEO / GEO Structured FAQ Data for SEO Ustaad USA
const faqItems = [
  {
    question: "How fast will my new website load for customers in the US?",
    answer: "Your website will open in under 1 second! 53% of people leave slow websites if they take more than 3 seconds. Ours open instantly on iPhones, Androids, and laptops so you never lose a customer."
  },
  {
    question: "How do you get my business recommended by ChatGPT and Google?",
    answer: "We add clean code and structured data that AI search engines read easily. When someone in the US asks ChatGPT, Claude, or Google for a recommendation in your industry, AI suggests your brand first."
  },
  {
    question: "How long does it take to build and launch my website?",
    answer: "Exactly 14 days! You get regular updates during the 2-week sprint and can see your site being built live before we launch."
  },
  {
    question: "Do I have to pay monthly subscription fees?",
    answer: "No! You own 100% of your website, code, and design. There are zero mandatory monthly software fees or lock-in contracts."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section id="faq" class="product-tile product-tile-dark">
  <!-- AEO FAQ Schema injection -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="tile-container">
    <span class="eyebrow dark">CLEAR ANSWERS TO YOUR QUESTIONS</span>
    <h2 class="display-lg">Frequently Asked Questions</h2>
    <p class="lead-text light">Simple, honest answers for US business owners.</p>

    <div class="faq-accordion">
      {faqItems.map((item, index) => (
        <details class="faq-item" open={index === 0}>
          <summary class="faq-question">
            <h3>{item.question}</h3>
            <span class="chevron">+</span>
          </summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-accordion {
    max-width: 860px;
    margin: 48px auto 0;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-item {
    background: var(--color-surface-tile-2);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 24px 32px;
    transition: background 0.2s ease;
  }

  .faq-item[open] {
    background: var(--color-surface-tile-3);
    border-color: var(--color-primary-on-dark);
  }

  .faq-question {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question h3 {
    font-size: 19px;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.35;
  }

  .chevron {
    font-size: 24px;
    color: var(--color-primary-on-dark);
    font-weight: 300;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .chevron {
    transform: rotate(45deg);
  }

  .faq-answer {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .faq-answer p {
    font-size: 16px;
    color: var(--color-body-muted);
    line-height: 1.6;
  }
</style>
