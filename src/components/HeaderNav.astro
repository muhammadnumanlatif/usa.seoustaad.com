---
---

<!-- Global Top Nav (Apple Style - Pure Black 44px) -->
<header class="global-nav">
  <div class="nav-inner">
    <a href="/" class="brand-logo">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="2.5">
        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
      </svg>
      <span>SEO USTAAD <span class="brand-sub">USA</span></span>
    </a>
    
    <nav class="nav-links">
      <a href="/">Home</a>
      <a href="#services">Services</a>
      <a href="#performance">1-Sec Speed</a>
      <a href="#us-advantage">Why US Loves Us</a>
      <a href="#faq">Simple FAQ</a>
    </nav>

    <div class="nav-actions">
      <span class="tz-badge">EST / PST Active</span>
      <a href="#booking-modal" class="nav-cta-pill" id="nav-book-btn">Get Quote</a>
    </div>
  </div>
</header>

<!-- Frosted Sub Nav (Sticks below top nav at 44px) -->
<div class="frosted-sub-nav dark">
  <div class="sub-nav-inner">
    <span class="category-title">1-Sec Load • #1 Search Ranking • 14 Days</span>
    <div class="sub-nav-actions">
      <span class="specs-pill">Zero Monthly Fees</span>
      <a href="#booking-modal" class="button-primary btn-sm">Get Free Quote</a>
    </div>
  </div>
</div>

<style>
  .global-nav {
    height: 44px;
    background-color: #000000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
  }

  .nav-inner {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-sub {
    color: var(--color-primary-on-dark);
    font-weight: 800;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-links a {
    color: #cccccc;
    font-size: 12px;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-links a:hover {
    color: #ffffff;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
  }

  .tz-badge {
    font-size: 11px;
    background: rgba(0, 240, 255, 0.1);
    color: #00f0ff;
    border: 1px solid rgba(0, 240, 255, 0.25);
    padding: 3px 9px;
    border-radius: 9999px;
    font-weight: 500;
  }

  .nav-cta-pill {
    background: var(--color-primary);
    color: #ffffff;
    font-size: 12px;
    font-weight: 500;
    padding: 5px 14px;
    border-radius: 9999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }

  .nav-cta-pill:hover {
    background: #0052a3;
  }

  /* Frosted Sub Nav Bar (52px) */
  .sub-nav-inner {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .category-title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0; /* Enables flex child ellipsis truncation */
  }

  .sub-nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .specs-pill {
    font-size: 12px;
    color: var(--color-ink-muted-48);
  }

  .btn-sm {
    padding: 6px 16px;
    font-size: 13px;
    white-space: nowrap;
  }

  /* Mobile Viewport Responsiveness Rules */
  @media (max-width: 768px) {
    .nav-inner {
      padding: 0 16px;
    }

    .frosted-sub-nav {
      padding: 0 16px;
    }

    .nav-links, .specs-pill {
      display: none;
    }

    .category-title {
      font-size: 12px;
    }
  }

  @media (max-width: 520px) {
    .tz-badge {
      display: none;
    }
  }
</style>
