---
// AEO / GEO Structured FAQ Data for Schema.org
const faqItems = [
  {
    question: "How does scroll-triggered video scrubbing improve conversion rates for US tech startups?",
    answer: "Scroll-triggered canvas video scrubbing turns static marketing copy into an interactive narrative. By allowing visitors to scrub through 3D product assemblies or web UI mockups frame-by-frame, session duration increases by up to 240%, creating high brand recall and driving higher qualified lead conversions for US tech startups."
  },
  {
    question: "Why is HTML5 Canvas frame sequence preferred over HTML5 video scrubbing on mobile iOS Safari?",
    answer: "Native HTML5 <video> elements rely on compressed I-frames and keyframe scrubbing, causing significant frame stutter and latency on mobile browsers like iOS Safari. Our HTML5 Canvas frame sequence engine pre-renders WebP image frames onto an accelerated 2D/WebGL canvas context, ensuring true 60fps hardware-synchronized scroll scrubbing on all mobile and desktop browsers."
  },
  {
    question: "What is the delivery timeline and investment for a bespoke GSAP animated website in the USA?",
    answer: "Standard high-ticket scroll-trigger animated websites range from $5,000 to $25,000 USD depending on 3D canvas asset complexity, interactive scope, and custom API integrations. Our typical sprint cycle delivers production-ready Astro.js sites in 2 to 4 weeks."
  },
  {
    question: "How do you guarantee 100/100 Google Lighthouse Core Web Vitals while running 60fps animations?",
    answer: "We build on Astro.js static site generation architecture, serving 100% pre-rendered zero-JS HTML for search engines (AEO/GEO optimization). JavaScript for GSAP and Lenis is loaded lazily and offloaded to RAF (requestAnimationFrame), preventing main-thread blocking and maintaining sub-second Largest Contentful Paint (LCP) and zero Cumulative Layout Shift (CLS)."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section id="faq" class="product-tile product-tile-dark">
  <!-- AEO FAQ Schema injection -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="tile-container">
    <span class="eyebrow dark">AEO / GEO ANSWER ENGINE OPTIMIZATION</span>
    <h2 class="display-lg">Frequently Asked Questions</h2>
    <p class="lead-text light">Direct answers for AI Search Engines (ChatGPT, Perplexity, Claude) and US Tech Buyers.</p>

    <div class="faq-accordion">
      {faqItems.map((item, index) => (
        <details class="faq-item" open={index === 0}>
          <summary class="faq-question">
            <h3>{item.question}</h3>
            <span class="chevron">+</span>
          </summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-accordion {
    max-width: 840px;
    margin: 48px auto 0;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-item {
    background: var(--color-surface-tile-2);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 24px 32px;
    transition: background 0.2s ease;
  }

  .faq-item[open] {
    background: var(--color-surface-tile-3);
    border-color: var(--color-primary-on-dark);
  }

  .faq-question {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question h3 {
    font-size: 19px;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.3;
  }

  .chevron {
    font-size: 24px;
    color: var(--color-primary-on-dark);
    font-weight: 300;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .chevron {
    transform: rotate(45deg);
  }

  .faq-answer {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .faq-answer p {
    font-size: 16px;
    color: var(--color-body-muted);
    line-height: 1.6;
  }
</style>
