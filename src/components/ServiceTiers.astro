<section id="services">
  <!-- Tile 1: Full-bleed Light Tile (Pure White) -->
  <div class="product-tile product-tile-light">
    <div class="tile-container">
      <span class="eyebrow">WHAT WE DO FOR YOU</span>
      <h2 class="display-lg">3 Simple Ways We Help Your Business Win</h2>
      <p class="lead-text">Everything you need to look amazing online, load super-fast, and get more US customers every day.</p>
      
      <div class="feature-grid">
        <div class="feature-card">
          <div class="icon-wrap">⚡</div>
          <h3>1-Second Load Speed</h3>
          <p>Your website opens in under 1 second. No waiting, no lag, no glitching on phones or computers.</p>
        </div>
        <div class="feature-card">
          <div class="icon-wrap">🤖</div>
          <h3>ChatGPT & Google #1 Search</h3>
          <p>We make sure Google ranks you at the top and ChatGPT recommends your business to people in the US.</p>
        </div>
        <div class="feature-card">
          <div class="icon-wrap">✨</div>
          <h3>Cool 3D Scroll Animations</h3>
          <p>Interactive 3D graphics that move as visitors scroll, making your brand look like Apple or Tesla.</p>
        </div>
      </div>
      
      <div class="tile-actions">
        <a href="#booking-modal" class="button-primary">Get Your Free Proposal</a>
      </div>
    </div>
  </div>

  <!-- Tile 2: Full-bleed Dark Tile (Void Black / Apple Tile 1) -->
  <div class="product-tile product-tile-dark" id="performance">
    <div class="tile-container">
      <span class="eyebrow dark">GUARANTEED SPEED REPORT</span>
      <h2 class="display-lg">100 / 100 Perfect Speed Guarantee</h2>
      <p class="lead-text light">Most websites are slow and glitchy. We guarantee your site gets a 100/100 score on Google Speed tests.</p>

      <div class="vitals-dashboard">
        <div class="metric-box">
          <span class="metric-value green">100 Score</span>
          <span class="metric-label">Super Fast Speed</span>
        </div>
        <div class="metric-box">
          <span class="metric-value green">100 Score</span>
          <span class="metric-label">Works on All Phones</span>
        </div>
        <div class="metric-box">
          <span class="metric-value green">100 Score</span>
          <span class="metric-label">Best Google Coding</span>
        </div>
        <div class="metric-box">
          <span class="metric-value green">100 Score</span>
          <span class="metric-label">ChatGPT & AI Ready</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Tile 3: Full-bleed Parchment Tile (Apple Off-White #f5f5f7) -->
  <div class="product-tile product-tile-parchment" id="us-advantage">
    <div class="tile-container">
      <span class="eyebrow">WHY US CLIENTS TRUST US</span>
      <h2 class="display-lg">Simple, Honest & Fast Development</h2>
      <p class="lead-text">No complicated technical talk. We make building your new website easy and stress-free.</p>

      <div class="advantage-list">
        <div class="advantage-item">
          <span class="badge">US TIME ZONES</span>
          <div>
            <h4>We Work When You Work</h4>
            <p>We are available during standard US business hours (EST, CST, PST) on Slack, Zoom, and email.</p>
          </div>
        </div>

        <div class="advantage-item">
          <span class="badge">14 DAYS</span>
          <div>
            <h4>Ready in Exactly 14 Days</h4>
            <p>You don't have to wait 6 months. We design, code, and launch your website in just 2 weeks.</p>
          </div>
        </div>

        <div class="advantage-item">
          <span class="badge">YOU OWN IT 100%</span>
          <div>
            <h4>No Monthly Lock-in Fees</h4>
            <p>You own 100% of your website, domain, and code. No hidden monthly charges or surprise fees.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--color-primary);
    margin-bottom: 12px;
    display: inline-block;
  }

  .eyebrow.dark {
    color: var(--color-primary-on-dark);
  }

  .lead-text.light {
    color: var(--color-body-muted);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin: 48px 0;
    text-align: left;
  }

  .feature-card {
    background: var(--color-surface-pearl);
    padding: 32px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-hairline);
  }

  .icon-wrap {
    font-size: 28px;
    margin-bottom: 16px;
  }

  .feature-card h3 {
    font-size: 20px;
    margin-bottom: 8px;
  }

  .feature-card p {
    font-size: 15px;
    color: var(--color-ink-muted-80);
    line-height: 1.55;
  }

  .vitals-dashboard {
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
    margin-top: 48px;
  }

  .metric-box {
    background: var(--color-surface-tile-2);
    padding: 24px 32px;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    min-width: 170px;
  }

  .metric-value {
    font-size: 32px;
    font-weight: 700;
    font-family: var(--font-display);
    display: block;
    margin-bottom: 4px;
  }

  .metric-value.green {
    color: #30d158;
  }

  .metric-label {
    font-size: 13px;
    color: var(--color-body-muted);
    letter-spacing: 0.05em;
  }

  .advantage-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 48px;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
    text-align: left;
  }

  .advantage-item {
    background: #ffffff;
    padding: 24px 32px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-hairline);
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .badge {
    background: var(--color-primary);
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 9999px;
    white-space: nowrap;
  }

  .advantage-item h4 {
    font-size: 18px;
    margin-bottom: 4px;
  }

  .advantage-item p {
    font-size: 15px;
    color: var(--color-ink-muted-80);
  }

  .tile-actions {
    margin-top: 32px;
  }
</style>
