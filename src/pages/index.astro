---
import Layout from '../layouts/Layout.astro';
import HeaderNav from '../components/HeaderNav.astro';
import ScrollVideoCanvas from '../components/ScrollVideoCanvas.astro';
import ServiceTiers from '../components/ServiceTiers.astro';
import AeoFaqSection from '../components/AeoFaqSection.astro';
import ProjectEstimatorModal from '../components/ProjectEstimatorModal.astro';
---

<Layout title="SEO Ustaad USA | Bespoke Scroll-Trigger Motion & AEO/GEO Web Architecture">
  <HeaderNav />

  <main>
    <ScrollVideoCanvas />
    <ServiceTiers />
    <AeoFaqSection />
  </main>

  <footer class="apple-footer">
    <div class="footer-container">
      <div class="footer-grid">
        <div class="footer-col">
          <h4>SEO Ustaad USA Services</h4>
          <ul>
            <li><a href="#services">60fps Scroll Video Canvas</a></li>
            <li><a href="#services">AEO & GEO AI Optimization</a></li>
            <li><a href="#performance">100/100 Core Web Vitals</a></li>
            <li><a href="#us-advantage">US Enterprise 14-Day Sprint</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>US Target Markets</h4>
          <ul>
            <li>San Francisco, CA (PST)</li>
            <li>New York, NY (EST)</li>
            <li>Austin, TX (CST)</li>
            <li>Seattle, WA (PST)</li>
            <li>Chicago, IL (CST)</li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Technology Stack</h4>
          <ul>
            <li>Astro.js Static Zero-JS Architecture</li>
            <li>GSAP 3 & ScrollTrigger Engine</li>
            <li>Lenis Inertia Smooth Scroll</li>
            <li>Schema.org JSON-LD Entities</li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© 2026 SEO Ustaad USA. All Rights Reserved. Engineered for High-Ticket US Web Development & AI Search Dominance.</p>
      </div>
    </div>
  </footer>

  <ProjectEstimatorModal />

  <!-- Initialize GSAP ScrollTrigger Engine -->
  <script>
    import { initScrollEngine } from '../scripts/scroll-engine.js';
    document.addEventListener('DOMContentLoaded', () => {
      initScrollEngine();
    });
  </script>
</Layout>

<style>
  .apple-footer {
    background-color: var(--color-canvas-parchment);
    color: var(--color-ink-muted-80);
    padding: 64px 24px 32px;
    border-top: 1px solid var(--color-hairline);
  }

  .footer-container {
    max-width: 1080px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
    margin-bottom: 48px;
  }

  .footer-col h4 {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 16px;
    letter-spacing: 0.02em;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col a, .footer-col li {
    font-size: 13px;
    color: var(--color-ink-muted-80);
    text-decoration: none;
    line-height: 1.5;
  }

  .footer-col a:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    padding-top: 24px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    text-align: center;
  }

  .footer-bottom p {
    font-size: 12px;
    color: var(--color-ink-muted-48);
  }
</style>
